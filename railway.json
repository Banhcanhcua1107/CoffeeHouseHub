{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "install": {
          "cmds": [
            "npm install --workspaces --include-workspace-root",
            "cd backend && npm install"
          ]
        },
        "build": {
          "cmds": ["npm run build || true"]
        },
        "start": {
          "cmds": ["npm run start:backend"]
        }
      }
    }
  }
}