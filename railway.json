{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "install": {
          "cmds": [
            "npm install",
            "cd backend && npm install"
          ]
        },
        "build": {
          "cmds": []
        },
        "start": {
          "cmds": [
            "cd backend && npm start"
          ]
        }
      }
    }
  }
}